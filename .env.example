# ==============================================================================
# SOCIETY MAINTENANCE TRACKER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection URL
# For SQLite (default local development zero-setup):
DATABASE_URL="file:./dev.db"
# For PostgreSQL / Supabase in production:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require"

# JWT Secret for Session Cookies and API Tokens
JWT_SECRET="super-secret-jwt-token-key-for-development-society-tracker-2026"

# Base Application URL (used in email notifications and deep links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Society Name Displayed across the portal
NEXT_PUBLIC_SOCIETY_NAME="Greenwood Heights Residents Association"

# Email Provider Configuration (Resend)
# Leave blank to use built-in Development Mock Logger (will not crash, prints email preview in console)
RESEND_API_KEY=""
EMAIL_FROM="Greenwood Heights Maintenance <notifications@resend.dev>"

# Optional Cloud Storage (Supabase / AWS S3 / Cloudinary)
# If left blank, files are safely uploaded to /public/uploads/ locally
STORAGE_PROVIDER="local"
