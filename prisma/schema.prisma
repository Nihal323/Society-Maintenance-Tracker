generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("RESIDENT") // "RESIDENT" | "ADMIN"
  unitNumber   String?     // E.g., "Tower A - 402", "Villa 12"
  phone        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  complaints   Complaint[] @relation("ResidentComplaints")
  actionsTaken ComplaintHistory[] @relation("ActorHistory")
  noticesAuthored Notice[] @relation("AuthorNotices")

  @@index([role])
  @@index([email])
}

model Complaint {
  id          String    @id @default(cuid())
  title       String
  description String
  category    String    // E.g., "Plumbing", "Electrical", "Cleaning", etc.
  photoUrl    String?   // Path or URL to uploaded photo
  priority    String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  status      String    @default("OPEN")   // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  
  residentId  String
  resident    User      @relation("ResidentComplaints", fields: [residentId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime? // Set when status becomes RESOLVED

  history     ComplaintHistory[]

  @@index([residentId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

model ComplaintHistory {
  id             String    @id @default(cuid())
  complaintId    String
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  previousStatus String?   // "OPEN" | "IN_PROGRESS" | "RESOLVED" | null
  newStatus      String    // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  
  actorId        String
  actor          User      @relation("ActorHistory", fields: [actorId], references: [id], onDelete: Cascade)
  
  note           String?
  timestamp      DateTime  @default(now())

  @@index([complaintId])
  @@index([timestamp])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("General") // "General", "Emergency", "Maintenance", "Rules & Regulations", etc.
  isPinned  Boolean  @default(false)
  
  authorId  String
  author    User     @relation("AuthorNotices", fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPinned])
  @@index([createdAt])
}

model SystemConfiguration {
  key         String   @id // e.g. "OVERDUE_THRESHOLD_DAYS", "SOCIETY_NAME", "DEFAULT_PRIORITY"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
